# Public-only sharing, independent accounts on every node. See docs/ISOLATION.md.
[node]
role = "primary"
# Replica only:
# primary_url = "https://primary.example.com"
# Local administration/encryption key: supply OCIPROXY_SECRET instead.
# secret = "generate-a-unique-local-secret-for-this-node"

[server]
listen = "0.0.0.0"
port = 5000

[storage]
path = "./var"

[auth]
# Local bootstrap account; do not share its password between nodes.
# push_username = "admin"
# push_password = "supply-through-OCIPROXY_PUSH_PASSWORD"

[replication]
# Replica only: separate from this node's local administration secret.
# id = "site-a"
# token = "supply-through-OCIPROXY_REPLICATION_TOKEN"

# Primary only: grant each replica its own public-sharing credential.
# [replication.peers.site-a]
# token = "generate-a-unique-peer-token"
# publish = false

[access]
default_visibility = "private"

[sources]
managed = true

[cache]
tag_ttl = 300

[gc]
interval = 3600
manifest_max_idle_days = 0
blob_grace = 86400
disk_high_percent = 0
disk_low_percent = 75
max_cache_bytes = 0

[uploads]
idle_timeout = 900
max_sessions = 256

[network]
# Each node may need egress for its own private sources.
# upstream_proxy = "http://proxy.example.com:3128"

[[upstream]]
name = "dockerhub"
prefix = "dockerhub"
base_url = "https://registry-1.docker.io"
official_namespace = "library"
sharing = "public"
visibility = "public"

[[upstream]]
name = "ghcr"
base_url = "https://ghcr.io"
sharing = "public"
visibility = "public"

[[upstream]]
name = "quay"
base_url = "https://quay.io"
sharing = "public"
visibility = "public"

# Private Docker/OCI sources default to local/private on either role.
# [[upstream]]
# name = "company"
# base_url = "https://registry.internal.example"
# username = "robot"
# password = "configure-in-this-node-UI-or-secret"

[[helm]]
name = "jetstack"
base_url = "https://charts.jetstack.io"
sharing = "public"
visibility = "public"

# [[helm]]
# name = "companycharts"
# base_url = "https://charts.internal.example"
# Local/private by default; credentials stay on this node.
