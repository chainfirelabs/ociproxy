# Copy to .env next to compose.yaml and replace every REPLACE_* value before deployment.
# Published images (GitHub Container Registry). Keep both on the same version;
# pin a digest (image@sha256:...) for fully immutable deployments.
OCIPROXY_IMAGE=ghcr.io/chainfirelabs/ociproxy:1.0.2
OCIPROXY_UI_IMAGE=ghcr.io/chainfirelabs/ociproxy/ui:1.0.2
# This node's TOML config, relative to compose.yaml (default ./ociproxy.toml).
# NODE_CONFIG=./ociproxy.toml

# Generate each local secret/password independently: openssl rand -hex 32
# Never copy these two values to another node. Keep the local secret backed up.
OCIPROXY_SECRET=REPLACE_WITH_UNIQUE_REPLICA_SECRET
PUSH_USERNAME=admin
PUSH_PASSWORD=REPLACE_WITH_UNIQUE_REPLICA_PASSWORD

# This node's DNS name only: no https:// and no path. The registry and the web
# UI share it (https://registry-replica.example.com/v2/ and https://registry-replica.example.com/).
# Clients reach it on TCP 443; port 80 only redirects to HTTPS.
OCIPROXY_HOST=registry-replica.example.com
# Certificate for OCIPROXY_HOST: a folder holding tls.crt (full chain, leaf
# first) and tls.key, relative to compose.yaml. For Let's Encrypt instead, use
# docker/compose.letsencrypt.yml (see docs/DOCKER.md).
# TLS_CERT_DIR=./certs
# Internal CAs to trust for replication, upstream HTTPS and the UI's OIDC
# provider (for example the CA that signed the primary's or the identity
# provider's certificate): put *.crt/*.pem files in ./trust.
# TRUST_DIR=./trust
TRAEFIK_IMAGE=traefik:v3.7.17
# The primary's OCIPROXY_HOST, as an HTTPS URL. Its certificate must be
# publicly trusted, or signed by a CA you put in ./trust (see TRUST_DIR).
PRIMARY_URL=https://registry-primary.example.com
# Must match the site-a entry in the primary's REPLICATION_PEERS exactly.
REPLICATION_ID=site-a
REPLICATION_TOKEN=REPLACE_WITH_SITE_A_TOKEN

REGISTRY_MEMORY_LIMIT=1g
UI_MEMORY_LIMIT=256m
TRAEFIK_MEMORY_LIMIT=256m
DEFAULT_VISIBILITY=private
TAG_TTL=300
GC_MANIFEST_MAX_IDLE_DAYS=0
GC_INTERVAL=3600
GC_BLOB_GRACE=86400
GC_DISK_HIGH_PERCENT=85
GC_DISK_LOW_PERCENT=75
GC_MAX_CACHE_BYTES=0
# Optional upstream-only HTTP proxy; replication always connects directly.
# UPSTREAM_PROXY=http://proxy.example.com:3128
# Optional OIDC is configured independently per node; see .env.example.
