# Copy to .env and fill in.  docker compose reads .env automatically.

# Local primary administration/UI secret; never reuse it for replication.
# Guards this primary's local /internal administration endpoints.
# Generate with: openssl rand -hex 32
OCIPROXY_SECRET=change-me-openssl-rand-hex-32

# Primary bootstrap admin: not stored; each replica has its own below. Use it to sign in to
# the web UI (or run `ociproxy user add`) and create real users.
PUSH_USERNAME=ci
PUSH_PASSWORD=change-me-too

# Visibility of repos not set per upstream / Helm repo / [access] rule in
# ociproxy.toml: "public" (anyone can pull) or "private" (signed-in
# users only: docker login <registry> -u <user> with a password or token).
DEFAULT_VISIBILITY=public

# Seconds a cached tag (e.g. :latest) is served before it is revalidated
# against the upstream registry. Digests are never revalidated.
TAG_TTL=300

# Garbage collection: expire mirrored (upstream) images nobody has pulled for
# this many days; their unreferenced layers are then deleted. 0 = keep forever.
# Pushed images are never expired.
GC_MANIFEST_MAX_IDLE_DAYS=0

# Log format: text or json (one JSON object per line).
LOG_FORMAT=text

# Web UI: how browsers reach it (needed for single sign-on).
# UI_PUBLIC_URL=https://registry-ui.example.com

# Optional single sign-on through an OIDC provider such as Authentik.
# Authentik: Applications > Providers > OAuth2/OpenID Provider, confidential
# client, redirect URI ${UI_PUBLIC_URL}/auth/oidc/callback. OIDC_ISSUER is
# its "OpenID Configuration Issuer" URL.
# OIDC_ISSUER=https://auth.example.com/application/o/ociproxy/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Authentik
# Roles from Authentik groups (members of neither group get "reader";
# set OIDC_READER_GROUP to admit only its members):
# OIDC_ADMIN_GROUP=registry-admins
# OIDC_PUSHER_GROUP=registry-pushers
# OIDC_READER_GROUP=registry-users

# Host ports.
PRIMARY_PORT=5000
REPLICA1_PORT=5001
REPLICA2_PORT=5002
UI_PORT=8080

# Upstream egress proxy (optional, primary only in this Compose file).
# Replicas fetch shared public content through the primary and their local
# private sources directly. Credentials for the proxy go in its URL.
# UPSTREAM_PROXY=http://proxy.corp:3128
# Or the generic variables (used when UPSTREAM_PROXY is unset):
# HTTP_PROXY=http://proxy.corp:3128
# HTTPS_PROXY=http://proxy.corp:3128
# NO_PROXY=localhost,127.0.0.1

# Independent replica local secrets, passwords and pairwise replication tokens.
# Generate each secret/token separately with: openssl rand -hex 32
REPLICA1_SECRET=replace-with-unique-local-secret-1
REPLICA2_SECRET=replace-with-unique-local-secret-2
REPLICA1_PUSH_PASSWORD=replace-with-independent-password-1
REPLICA2_PUSH_PASSWORD=replace-with-independent-password-2
REPLICA1_REPLICATION_TOKEN=replace-with-unique-peer-token-1
REPLICA2_REPLICATION_TOKEN=replace-with-unique-peer-token-2
# REPLICA1_CONFIG=./ociproxy-replica1.toml
# REPLICA2_CONFIG=./ociproxy-replica2.toml
REPLICA1_UI_PORT=8081
REPLICA2_UI_PORT=8082
